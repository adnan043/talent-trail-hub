# Settings for running this site on YOUR OWN computer. Hosted sites and the editor get
# theirs from the platform: nothing here is used there.
#
# `npm run setup` copies this file to `.env` and fills in JWT_SECRET and DATABASE_URL for you.
# `.env` stays on your computer (git ignores it): never commit it, never paste it anywhere.

# REQUIRED. The database: a Postgres connection string.
# `npm run setup` sets the local one from docker-compose.yml (`docker compose up -d db`):
#   postgresql://postgres:dev@localhost:5432/site
# Empty: sign-in and the job board answer 503 "site_database_disabled".
DATABASE_URL=

# Optional, for docker-compose.yml only (the site never reads it): the port the local database
# listens on when 5432 is taken. Use the same port in DATABASE_URL.
# DB_PORT=5433

# REQUIRED. Signs sign-in tokens and keys the rate limits: 32 or more random characters.
# `npm run setup` makes one; by hand: `openssl rand -base64 48`.
# Missing or shorter: sign-in answers 503 "auth_not_configured".
# Changing it signs everyone out.
JWT_SECRET=

# Leave EMPTY on your computer. The Site Key is a secret the platform gives hosted sites, so
# they can send account emails. Empty turns on local development mode: sign-up and sign-in codes
# are printed where `npm run dev` runs, and `npm run dev-admin -- <email>` can make a local
# admin. Any value turns that mode off.
SITE_KEY=

# Leave empty on your computer. The site's address on the platform, where it answers /api/*.
SITE_URL=

# Leave empty. `1` only in the editor Preview: never set it on your computer or a live site.
SITE_PREVIEW=

# Leave empty. The platform's opaque id for the account's owner (never an email). The owner
# opens the admin only with "View as admin" in the dashboard.
SITE_OWNER_ID=
