{
  "name": "site-app",
  "version": "0.10.22",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "prisma generate && astro dev",
    "build": "prisma generate && astro build",
    "preview": "astro preview",
    "test": "prisma generate && vitest run",
    "studio": "prisma studio --browser none --port 5555",
    "platform": "node scripts/platform.mjs",
    "db:local": "podman start tth-pg",
    "check": "npm test && npm run build",
    "setup": "node scripts/platform.mjs setup",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "dev-admin": "node scripts/platform.mjs dev-admin"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.4",
    "@astrojs/react": "^7.0.1",
    "@fontsource-variable/plus-jakarta-sans": "~5.3.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/adapter-ppg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@prisma/driver-adapter-utils": "7.10.1",
    "@prisma/ppg": "1.0.1",
    "@stripe/stripe-js": "10.1.0",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-router": "^1.170.42",
    "astro": "^7.3.8",
    "hono": "^4.13.13",
    "pg-types": "4.0.2",
    "postgres-array": "3.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "uqr": "0.1.3",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "7.10.1",
    "typescript": "^5.9.3",
    "vitest": "4.1.12"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "fsevents": false,
    "workerd@1.20261110.1": true
  }
