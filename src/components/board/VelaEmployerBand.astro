---
/**
 * The "For employers" band in the Vela design (src/styles/home-vela.css `.v-band`), shared by the
 * home page and /jobs/: three steps beside a price card with the cheapest active listing tier
 * ("Free" when free posting is on). Callers hide it on single-company boards (no employer posting).
 */
import {HOME} from '../../content/site';
import type {PublicTier} from '../../lib/types-public';

interface Props {
  tiers: {tiers: PublicTier[]; freePosting: boolean} | null;
  /** Unique per page: the section's heading id. */
  titleId?: string;
}

const {tiers, titleId = 'employer-cta-title'} = Astro.props;
const cheapest = (tiers?.tiers ?? []).reduce<PublicTier | null>((low, t) => (!low || t.priceCents < low.priceCents ? t : low), null);
const shortest = (tiers?.tiers ?? []).reduce<number | null>((low, t) => (low == null || t.durationDays < low ? t.durationDays : low), null);
const money = (cents: number, currency: string) => {
  try {
    return new Intl.NumberFormat('en-US', {style: 'currency', currency, maximumFractionDigits: cents % 100 === 0 ? 0 : 2}).format(cents / 100);
  } catch {
    return `${(cents / 100).toFixed(2)} ${currency}`;
  }
};
const priceLabel = tiers?.freePosting ? 'Free' : cheapest ? money(cheapest.priceCents, cheapest.currency) : null;
---

<section class="v-section" aria-labelledby={titleId}>
  <div class="v-band">
    <div class="v-band-text">
      <p class="v-band-kicker">For employers</p>
      <h2 id={titleId} class="v-band-title">
        Hiring? Reach people<br />who are looking right now.
      </h2>
      <p class="v-band-lead">Post in a few minutes. Candidates apply directly, and you pay once per listing with no subscription.</p>
      <ol class="v-steps">
        <li class="v-step">
          <span class="v-step-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" focusable="false">
              <path d="M12 20h9"></path>
              <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"></path>
            </svg>
          </span>
          <span class="v-step-title">Write your listing</span>
          <span class="v-step-body">A few minutes. Apply here, by link or email.</span>
        </li>
        <li class="v-step">
          <span class="v-step-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" focusable="false">
              <path d="M12 3 5 6v5c0 4.5 3 8.3 7 10 4-1.7 7-5.5 7-10V6l-7-3z"></path>
              <path d="m9 12 2 2 4-4"></path>
            </svg>
          </span>
          <span class="v-step-title">We review it</span>
          <span class="v-step-body">A real person checks it before it goes live.</span>
        </li>
        <li class="v-step">
          <span class="v-step-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" focusable="false">
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M22 21v-2a4 4 0 0 0-3-3.9M16 3.1a4 4 0 0 1 0 7.8"></path>
            </svg>
          </span>
          <span class="v-step-title">Meet applicants</span>
          <span class="v-step-body">Resumes and applicants land in your dashboard.</span>
        </li>
      </ol>
    </div>
    <div class="v-price">
      {
        priceLabel && (
          <div class="v-price-top">
            <span class="v-price-from">{tiers?.freePosting ? 'Listings are' : 'Listings from'}</span>
            <span class="v-price-line">
              <span class="v-price-amount">{priceLabel}</span>
              {!tiers?.freePosting && <span class="v-price-unit">per listing</span>}
            </span>
          </div>
        )
      }
      <ul class="v-price-list">
        {
          shortest != null && (
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <path d="m5 12 5 5L20 7"></path>
              </svg>
              Live for {shortest} days
            </li>
          )
        }
        <li>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="m5 12 5 5L20 7"></path>
          </svg>
          Pay once, no subscription
        </li>
        <li>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="m5 12 5 5L20 7"></path>
          </svg>
          Shown in Google for Jobs
        </li>
      </ul>
      <div class="v-price-actions">
        <a class="v-btn v-btn-primary v-btn-lg v-btn-full" href="/post-a-job/">
          {HOME.cta.action}
        </a>
        <a class="v-btn v-btn-secondary v-btn-lg v-btn-full" href="/pricing/">
          Compare plans
        </a>
      </div>
    </div>
  </div>
</section>
