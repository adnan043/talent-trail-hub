export type IconName = keyof typeof ICONS;

interface Props {
  name: IconName;
  class?: string;
}

const {name, class: className} = Astro.props;
const nodes = ICONS[name] as readonly (readonly ['path' | 'rect' | 'circle', Record<string, string>])[];
---

<svg
  class:list={['icon', className]}
  viewBox="0 0 24 24"
  width="24"
  height="24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false">
  {
    nodes.map(([Tag, attrs]) => <Tag {...attrs} />)
  }
</svg>
