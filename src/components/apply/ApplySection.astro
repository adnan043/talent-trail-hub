---
/**
 * F4 apply, on the job page (`<ApplySection job={…} />`). Applying needs a job seeker account.
 * - `onsite`: the browser asks `/site-api/applications/jobs/:slug/can-apply` and shows ONE step:
 *   sign in, set up the profile, finish it (photo, CV), or the one-click form (cover note,
 *   consent) made from the profile (./apply-form.ts).
 * - `url` / `email`: a button that opens the target; the click is counted.
 * Works on SSR and client-navigated pages (the script runs on every `astro:page-load`).
 */
import {DEFAULT_CONSENT_TEXT, LIMITS} from '../../lib/board';
import type {ApplyJob} from '../../lib/types-apply';
import '../../styles/board-pages.css';

interface Props {
  job: ApplyJob;
}
const {job} = Astro.props;

/** Only https links and plain addresses become links (the target was checked on save, too). */
function safeUrl(value: string | null): string | null {
  if (!value) return null;
  try {
    return new URL(value).protocol === 'https:' ? value : null;
  } catch {
    return null;
  }
}
const email = job.applyTarget && /^[^\s@"<>]+@[^\s@"<>]+\.[^\s@"<>]{2,}$/.test(job.applyTarget) ? job.applyTarget : null;
const url = job.applyMethod === 'url' ? safeUrl(job.applyTarget) : null;
const mailto = job.applyMethod === 'email' && email ? `mailto:${email}?subject=${encodeURIComponent(`Application: ${job.title}`)}` : null;
const id = `apply-${job.id}`;
---

<section class="bp-panel bp-pad apply-section" id="apply" aria-labelledby={`${id}-title`} data-apply-section data-slug={job.slug}>
  <h2 id={`${id}-title`} class="bp-subheading">Apply for this job</h2>
  {
    !job.open ? (
      <p class="notice">This job is no longer taking applications.</p>
    ) : job.applyMethod === 'onsite' ? (
      <div class="apply-onsite" data-apply-onsite>
        {/* What shows depends on the visitor (filled in the browser from `can-apply`, never in this HTML). */}
        <p class="muted" data-apply-loading>Checking your account…</p>
        <p class="notice" data-apply-blocked hidden></p>

        <div class="apply-step" data-apply-signin hidden>
          <p class="apply-lead">Sign in to apply. A free job seeker account keeps your profile, photo and CV, so every application takes one click, and you can follow its status.</p>
          <div class="apply-actions">
            <a class="button bp-lg" href={`/account/login/?next=${encodeURIComponent(`/jobs/${job.slug}/#apply`)}`}>Sign in to apply</a>
            <a class="button button-outline bp-lg" href={`/account/register/?as=applicant&next=${encodeURIComponent(`/jobs/${job.slug}/#apply`)}`}>Create an account</a>
          </div>
        </div>

        <div class="apply-step" data-apply-choose hidden>
          <p class="apply-lead">Set up your job seeker profile first: your photo and CV (your email comes from your account). It takes a minute, and then you come back here.</p>
          <div class="apply-actions">
            <a class="button bp-lg" href={`/dashboard/welcome?as=applicant&next=${encodeURIComponent(`/jobs/${job.slug}/#apply`)}`}>Set up my profile</a>
          </div>
        </div>

        <div class="apply-step" data-apply-incomplete hidden>
          <p class="apply-lead" data-apply-missing></p>
          <div class="apply-actions">
            <a class="button bp-lg" href="/dashboard/profile">Finish my profile</a>
          </div>
        </div>

        <form id={`${id}-form`} class="form-card apply-form" novalidate data-apply-form hidden>
          <p class="apply-lead">{job.companyName} will get your profile, photo and CV.</p>
          <dl class="apply-profile">
            <div><dt>Name</dt><dd data-profile-name></dd></div>
            <div><dt>Email</dt><dd data-profile-email></dd></div>
            <div><dt>Phone</dt><dd data-profile-phone></dd></div>
            <div><dt>CV</dt><dd data-profile-resume></dd></div>
          </dl>
          <p class="muted small">Not right? <a href="/dashboard/profile">Update your profile</a> first.</p>
          <div class="field full">
            <label for={`${id}-note`}>Cover note <span class="muted">(optional)</span></label>
            <textarea id={`${id}-note`} name="coverNote" rows="5" placeholder="A few lines on why you are a good fit." aria-describedby={`${id}-note-hint`}></textarea>
            <p class="field-hint" id={`${id}-note-hint`}>Up to {LIMITS.coverNote} characters.</p>
          </div>
          <div class="field full">
            <label class="check" for={`${id}-consent`}>
              <input id={`${id}-consent`} name="consent" type="checkbox" />
              <span>{DEFAULT_CONSENT_TEXT}</span>
            </label>
          </div>
          <p class="notice" data-form-status hidden></p>
          <div class="actions">
            <button class="button" type="submit">Apply now</button>
          </div>
        </form>
      </div>
    ) : url || mailto ? (
      <div class="apply-out">
        <p class="apply-lead">
          {url ? (
            `${job.companyName} takes applications on its own website.`
          ) : (
            <>
              Send your application to <strong>{email}</strong>.
            </>
          )}
        </p>
        <a class="button bp-lg" href={(url ?? mailto)!} data-apply-click {...(url ? {target: '_blank', rel: 'noopener noreferrer'} : {})}>
          {url ? 'Apply on the company site' : 'Apply by email'}
        </a>
      </div>
    ) : (
      <p class="notice">Ask {job.companyName} how to apply for this job.</p>
    )
  }
</section>

<style>
  .apply-section {
    display: grid;
    gap: 1.25rem;
  }
  .apply-section h2 {
    margin: 0;
  }
  .apply-section > h2 + .apply-lead,
  .apply-section > h2 + .apply-out {
    margin-top: -0.75rem;
  }
  .apply-form {
    gap: 1.25rem;
  }
  .apply-form .apply-lead {
    margin: -0.75rem 0 0.25rem;
  }
  .apply-form .actions {
    margin-top: 0.25rem;
  }
  .apply-form button[type='submit'] {
    min-height: 48px;
    padding: 0 22px;
    font-size: 1rem;
  }
  @media (max-width: 640px) {
    .apply-section .form-grid {
      grid-template-columns: 1fr;
    }
    .apply-form button[type='submit'] {
      width: 100%;
    }
  }
  .apply-section .check {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-weight: 400;
    font-size: 15px;
    line-height: 1.55;
  }
  .apply-section .check input {
    flex: none;
    width: 20px;
    height: 20px;
    min-height: 0;
    margin: 2px 0 0;
    padding: 0;
  }
  .apply-out {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }
  .apply-onsite,
  .apply-step {
    display: grid;
    gap: 1rem;
  }
  .apply-onsite [hidden] {
    display: none;
  }
  .apply-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .apply-profile {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem 1.5rem;
    margin: 0;
  }
  .apply-profile dt {
    font-size: 13px;
    color: var(--muted);
  }
  .apply-profile dd {
    margin: 0;
    font-weight: 500;
    overflow-wrap: anywhere;
  }
  @media (max-width: 640px) {
    .apply-profile {
      grid-template-columns: 1fr;
    }
    .apply-actions .button {
      width: 100%;
    }
  }
</style>

<script>
  import {bindApplySections} from './apply-form';

  document.addEventListener('astro:page-load', bindApplySections);
</script>
