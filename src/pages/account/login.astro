---
/**
 * Sign in. PRERENDERED (a file, no server work). The page opens on email + password
 * (`/site-api/auth/login`); "Email me a code instead" sends a 6-digit code to the
 * account (`/site-api/auth/code`, then `/code/verify`), which needs no password: the
 * site's admin, made by the platform without one, signs in that way. `?next=<path>` is where to go
 * afterwards (checked: same-site paths only). With two-step sign-in on, the first
 * step answers a challenge and the authenticator step
 * (`/site-api/auth/login/two-factor`) finishes it; `?mfa=<challenge>` opens that
 * step directly (a one-click sign-in from the dashboard, owner.ts). `?notice=` explains
 * why the visitor landed here (a dashboard link that expired). `<DemoLogin />` shows a store
 * preview's demo admin, and nothing anywhere else.
 *
 * The "Vela" design (src/styles/signin-vela.css, `skin="vela"`; docs: ~/Downloads/Sign in-html): the
 * forms on the left, a dark panel on the right. When `?next=` is a job page, the panel shows that
 * job ("You'll go straight back to"), read from `GET /site-api/jobs/:slug`; otherwise no card.
 */
import VelaRowIcon from '../../components/board/VelaRowIcon.astro';
import Base from '../../layouts/Base.astro';
import DemoLogin from '../../platform/DemoLogin.astro';
import {ROW_ICON_NAMES} from '../../lib/row-icon';
import {staticContext} from '../../server/page';
import '../../styles/home-vela.css';
import '../../styles/signin-vela.css';
import '../../styles/auth-shell.css';

export const prerender = true;

const {site, viewer} = await staticContext(Astro.request);
const name = site?.name ?? 'My site';
---

<Base site={site} viewer={viewer} isStatic noindex title="Sign in" skin="vela" bare>
  <main id="main" tabindex="-1" class="v-home v-si">
    <div class="v-si-wrap">
      <div class="v-si-card">
        <div class="v-si-main">
          <nav class="v-si-tabs" aria-label="Sign in or sign up">
            <a href="/account/login/" aria-current="page">Sign in</a>
            <a href="/account/register/" data-keep-next>Sign up</a>
          </nav>

          <div class="v-si-head">
            <h1 id="login-title">Welcome back</h1>
            <p id="login-sub">Sign in to apply, follow your applications or manage your job posts.</p>
          </div>
          <p class="notice notice-error" id="login-notice" role="alert" hidden></p>
          <!-- The store preview's read-only demo admin: shows only where the platform set it (docs/agent/store-apps.md). -->
          <DemoLogin />

          <!-- Or a code by email (no password needed): "Email me a sign-in code". -->
          <form id="email-form" class="v-si-form" novalidate hidden>
            <p class="v-si-lead" id="email-lead">Enter your email and we'll send you a 6-digit code. No password needed.</p>
            <div class="field">
              <label for="login-email">Email</label>
              <input id="login-email" name="email" type="email" autocomplete="username" inputmode="email" placeholder="name@example.com" />
            </div>
            <p class="notice" data-form-status hidden></p>
            <button class="v-si-go" type="submit">Email me a code</button>
          </form>

          <!-- 2. The emailed code. -->
          <form id="email-code-form" class="v-si-form" novalidate hidden>
            <p class="v-si-lead" id="email-code-lead" aria-live="polite"></p>
            <div class="field">
              <label for="email-code">Code from the email</label>
              <input id="email-code" name="code" type="text" autocomplete="one-time-code" inputmode="numeric" maxlength="7" spellcheck="false" placeholder="123456" />
            </div>
            <p class="notice" data-form-status hidden></p>
            <button class="v-si-go" type="submit">Sign in</button>
            <p class="v-si-links">
              <button class="v-si-link" type="button" id="code-resend">Send a new code</button>
              <span aria-hidden="true">·</span>
              <button class="v-si-link" type="button" id="code-other-email">Use another email</button>
            </p>
          </form>

          <!-- 1. The first form shown: email and password. -->
          <form id="login-form" class="v-si-form" novalidate>
            <div class="field">
              <label for="login-password-email">Email</label>
              <input id="login-password-email" name="email" type="email" autocomplete="username" inputmode="email" placeholder="name@example.com" />
            </div>
            <div class="field">
              <div class="v-si-label-row">
                <label for="login-password">Password</label>
                <a class="v-si-a" href="/account/forgot/">Forgot password?</a>
              </div>
              <div class="pw-input">
                <input id="login-password" name="password" type="password" autocomplete="current-password" placeholder="Your password" />
                <button class="pw-reveal" type="button" data-reveal-password aria-controls="login-password" aria-pressed="false" aria-label="Show password" hidden>Show</button>
              </div>
            </div>
            <p class="notice" data-form-status hidden></p>
            <button class="v-si-go" type="submit">
              Sign in
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </button>
          </form>

          <!-- Two-step sign-in: the authenticator code, after a password, an emailed code or one click. -->
          <form id="code-form" class="v-si-form" novalidate hidden>
            <p class="v-si-lead">Open your authenticator app and enter the 6-digit code for this site. Lost your phone? Enter one of your recovery codes instead.</p>
            <div class="field">
              <label for="login-code">Code</label>
              <input id="login-code" name="code" type="text" autocomplete="one-time-code" inputmode="numeric" maxlength="20" spellcheck="false" placeholder="123456" />
            </div>
            <p class="notice" data-form-status hidden></p>
            <button class="v-si-go" type="submit">Continue</button>
          </form>

          <!-- The other way in: a code by email, or back to the password. -->
          <div class="v-si-other" id="login-links">
            <div class="v-si-or"><span></span>or<span></span></div>
            <button class="v-si-alt" type="button" id="use-password" hidden>
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <rect x="4" y="11" width="16" height="10" rx="2" />
                <path d="M8 11V7a4 4 0 0 1 8 0v4" />
              </svg>
              Use a password instead
            </button>
            <button class="v-si-alt" type="button" id="use-code">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <rect x="2" y="4" width="20" height="16" rx="2" />
                <path d="m22 6-10 7L2 6" />
              </svg>
              Email me a sign-in code
            </button>
          </div>

          <p class="v-si-new">
            New to <span data-brand-text="{name}">{name}</span>? <a class="v-si-a" href="/account/register/" data-keep-next>Create a free account</a>
          </p>
        </div>

        <aside class="v-si-aside">
          <div class="v-si-aside-grid" aria-hidden="true"></div>
          <div class="v-si-aside-top">
            <span class="v-si-pill"><span class="v-si-pill-dot"></span>Candidates never pay</span>
            <div class="v-si-aside-head">
              <h2>Pick up where<br />you <span class="v-si-grad">left off</span></h2>
              <p id="login-back-lead">Sign in and you’ll go straight back to what you were doing.</p>
            </div>
            <ul class="v-si-perks">
              {
                ['Apply in one click with your saved CV', 'Follow every application, from sent to shortlisted', 'Save jobs and come back to them later'].map(perk => (
                  <li>
                    <span class="v-si-tick">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                        <path d="m5 12 5 5L20 7" />
                      </svg>
                    </span>
                    <span>{perk}</span>
                  </li>
                ))
              }
            </ul>
          </div>
          <!-- Filled in the browser when `?next=` is a job page (the job's own data); hidden otherwise. -->
          <div class="v-si-back" id="login-back" hidden>
            <span class="v-si-back-label">You’ll go straight back to</span>
            <div class="v-si-back-job">
              <span class="v-row-icon v-si-back-icon" id="login-back-icon" aria-hidden="true"></span>
              <div class="v-si-back-body">
                <span class="v-si-back-title" id="login-back-title"></span>
                <span class="v-si-back-meta" id="login-back-meta"></span>
              </div>
              <span class="v-si-back-pay" id="login-back-pay" hidden></span>
            </div>
            {
              ROW_ICON_NAMES.map(icon => (
                <template data-row-icon={icon}>
                  <VelaRowIcon icon={icon} />
                </template>
              ))
            }
          </div>
        </aside>
      </div>
    </div>
  </main>
</Base>

<script>
  import {nextParam, nextPath, signedIn, rememberSignUpEmail} from '../../lib/account';
  import {bindForm, postJson} from '../../lib/form';
  import {employmentLabel, formatSalary, workplaceAndPlace} from '../../lib/job-display';
  import {bindPasswordReveal} from '../../lib/password-checks';
  import {rowIcon} from '../../lib/row-icon';
  import type {JobDetailResponse} from '../../lib/types-public';
  import {AUTH_RULES, rules} from '../../lib/rules';
  import {siteFetch} from '../../platform/browser';

  // Client navigation (ClientRouter): a bundled script runs once, so this page's code runs on
  // every `astro:page-load` (the first load, each navigation, back/forward) while it is this page.
  document.addEventListener('astro:page-load', () => {
    if (!document.querySelector('#email-form')) return;
    bindPasswordReveal(document);
    const NOTICES: Record<string, string> = {
      'owner-link': 'That sign-in link has expired or was already used. Open the portal again from the dashboard, or sign in below.',
      suspended: 'This account is suspended. Contact the site owner.',
    };

    const params = new URLSearchParams(window.location.search);
    const next = nextPath();
    // What the sign-in routes get: the page's own `next` only. They answer where to go (an admin: the admin).
    const asked = nextParam();
    const notice = params.get('notice');
    const $ = <T extends HTMLElement>(id: string) => document.querySelector<T>(`#${id}`)!;
    const noticeBox = $('login-notice');
    if (notice && NOTICES[notice]) {
      noticeBox.textContent = NOTICES[notice];
      noticeBox.hidden = false;
    }
    document.querySelectorAll<HTMLAnchorElement>('[data-keep-next]').forEach(a => {
      a.href = `${a.pathname}?next=${encodeURIComponent(next)}`;
    });
    void showBackJob(next);

    const emailForm = $<HTMLFormElement>('email-form');
    const emailCodeForm = $<HTMLFormElement>('email-code-form');
    const loginForm = $<HTMLFormElement>('login-form');
    const codeForm = $<HTMLFormElement>('code-form');
    const forms = [emailForm, emailCodeForm, loginForm, codeForm];
    let challenge = '';
    let email = '';

    function show(form: HTMLFormElement, title: string, focus: string) {
      for (const f of forms) f.hidden = f !== form;
      $('login-title').textContent = title;
      $('login-sub').hidden = form !== loginForm;
      $('use-password').hidden = form !== emailForm;
      $('use-code').hidden = form !== loginForm;
      $('login-links').hidden = form === codeForm || form === emailCodeForm;
      $<HTMLInputElement>(focus).focus();
    }

    /** Two-step sign-in: keep the challenge in memory only, ask for the authenticator code. */
    function askTwoFactor(value: string) {
      challenge = value;
      noticeBox.hidden = true;
      show(codeForm, 'Enter your code', 'login-code');
    }

    /** After a one-click sign-in from the dashboard when two-step sign-in is on (`?mfa=`, 5 minutes). */
    const mfa = params.get('mfa');
    if (mfa) {
      history.replaceState(history.state, '', window.location.pathname + (params.get('next') ? `?next=${encodeURIComponent(next)}` : ''));
      askTwoFactor(mfa);
    } else {
      void signedIn().then(yes => yes && window.location.replace(next));
    }

    const done = (data: {next?: unknown} | null | undefined) => ({ok: true as const, redirect: typeof data?.next === 'string' ? data.next : next});

    async function sendCode(address: string) {
      const {result} = await postJson(siteFetch, '/site-api/auth/code', {email: address, next: asked});
      if (result.ok) {
        email = address;
        $('email-code-lead').textContent = `If ${address} has an account here, we sent it a 6-digit code. It works for 10 minutes. Check your spam folder if it isn't there.`;
      }
      return result;
    }

    bindForm(emailForm, {
      rules: {email: AUTH_RULES.email},
      pendingLabel: 'Sending…',
      async submit(values) {
        const result = await sendCode(String(values.email).trim());
        if (result.ok) {
          show(emailCodeForm, 'Check your email', 'email-code');
          return {ok: true};
        }
        return result;
      },
    });

    bindForm(emailCodeForm, {
      rules: {
        code: [
          rules.required('Enter the 6-digit code from the email.'),
          value => (/^\d{6}$/.test(value.replace(/\s/g, '')) ? null : 'Enter the 6-digit code from the email.'),
        ],
      },
      pendingLabel: 'Checking…',
      async submit(values) {
        const {result, data} = await postJson(siteFetch, '/site-api/auth/code/verify', {email, code: values.code, next: asked});
        if (result.ok && data?.twoFactor === true && typeof data.challenge === 'string') {
          askTwoFactor(data.challenge);
          return {ok: true};
        }
        return result.ok ? done(data) : result;
      },
    });

    const resend = $<HTMLButtonElement>('code-resend');
    resend.addEventListener('click', async () => {
      if (resend.disabled) return;
      const idle = resend.textContent ?? 'Send a new code';
      resend.disabled = true;
      resend.setAttribute('aria-busy', 'true');
      const spinner = document.createElement('span');
      spinner.className = 'spinner';
      spinner.setAttribute('aria-hidden', 'true');
      resend.replaceChildren(spinner, document.createTextNode('Sending…'));
      let result: Awaited<ReturnType<typeof sendCode>>;
      try {
        result = await sendCode(email);
      } catch {
        result = {ok: false, message: 'That did not work. Try again in a moment.'} as typeof result;
      } finally {
        resend.disabled = false;
        resend.removeAttribute('aria-busy');
        resend.replaceChildren(idle);
      }
      const status = emailCodeForm.querySelector<HTMLElement>('[data-form-status]')!;
      status.textContent = result.ok ? 'We sent a new code. Only the newest one works.' : result.message ?? 'That did not work. Try again in a moment.';
      status.hidden = false;
    });
    $('code-other-email').addEventListener('click', () => show(emailForm, 'Sign in', 'login-email'));
    $('use-password').addEventListener('click', () => {
      $<HTMLInputElement>('login-password-email').value = $<HTMLInputElement>('login-email').value;
      show(loginForm, 'Sign in with your password', 'login-password-email');
    });
    $('use-code').addEventListener('click', () => {
      $<HTMLInputElement>('login-email').value = $<HTMLInputElement>('login-password-email').value;
      show(emailForm, 'Sign in', 'login-email');
    });

    bindForm(loginForm, {
      rules: {email: AUTH_RULES.email, password: AUTH_RULES.password},
      pendingLabel: 'Signing in…',
      async submit(values) {
        const {result, data} = await postJson(siteFetch, '/site-api/auth/login', {...values, next: asked});
        // Never confirmed: this browser knows the password, and the emailed code finishes it.
        if ((data as {needsCode?: unknown} | null)?.needsCode) {
          rememberSignUpEmail(String(values.email));
          return {ok: true, redirect: `/account/verify/?next=${encodeURIComponent(next)}`};
        }
        if (result.ok && data?.twoFactor === true && typeof data.challenge === 'string') {
          askTwoFactor(data.challenge);
          return {ok: true};
        }
        // A wrong email or password is ONE generic line (the server never says which).
        return result.ok ? done(data) : result;
      },
    });

    bindForm(codeForm, {
      rules: {code: [rules.required('Enter the 6-digit code from your app, or a recovery code.')]},
      pendingLabel: 'Checking…',
      async submit(values) {
        const {result, data, res} = await postJson(siteFetch, '/site-api/auth/login/two-factor', {...values, challenge, next: asked});
        if (res?.status === 401) {
          // The challenge expired (5 minutes) or the password changed: start again.
          window.location.replace(`/account/login/?next=${encodeURIComponent(next)}`);
          return result;
        }
        return result.ok ? done(data) : result;
      },
    });
  });

  /**
   * The dark panel's "You'll go straight back to" card: only when `next` is a job page
   * (`/jobs/<slug>/…`) and that job is open. Read-only; any failure leaves the card hidden.
   */
  async function showBackJob(next: string) {
    const card = document.querySelector<HTMLElement>('#login-back');
    const match = /^\/jobs\/([^/?#]+)\/?(?:[?#]|$)/.exec(next);
    if (!card || !match) return;
    let slug: string;
    try {
      slug = decodeURIComponent(match[1]);
    } catch {
      return;
    }
    const data = await siteFetch(`/site-api/jobs/${encodeURIComponent(slug)}`)
      .then(res => (res.ok ? (res.json() as Promise<JobDetailResponse>) : null))
      .catch(() => null);
    const job = data?.job;
    // Gone, or the visitor moved on (client navigation) while it loaded.
    if (!job || job.state !== 'active' || !card.isConnected) return;
    const icon = rowIcon(job.title);
    const tile = card.querySelector<HTMLElement>('#login-back-icon')!;
    const svg = card.querySelector<HTMLTemplateElement>(`template[data-row-icon="${icon}"]`);
    tile.classList.add(`cat-${icon}`);
    if (svg) tile.replaceChildren(svg.content.cloneNode(true));
    card.querySelector('#login-back-title')!.textContent = job.title;
    card.querySelector('#login-back-meta')!.textContent = [job.company.name, workplaceAndPlace(job), employmentLabel(job.employmentType)].join(' · ');
    // The design's short range: "$45K – $55K" → "$45K–55K" (same symbol on both ends only).
    const pay = formatSalary(job.salary)?.replace(/^([^\d\s]*)([\d.,]+[KMBT]?) – \1([\d.,]+[KMBT]?)/, '$1$2–$3') ?? null;
    const payBox = card.querySelector<HTMLElement>('#login-back-pay')!;
    payBox.textContent = pay ?? '';
    payBox.hidden = !pay;
    document.querySelector('#login-back-lead')!.textContent = 'Sign in and you’ll land back on the job you were looking at, ready to apply.';
    card.hidden = false;
  }
</script>
