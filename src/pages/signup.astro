---
/**
 * `/signup/`: the old employer sign-up address. Sends employers to the account sign-up, then to
 * the post-a-job wizard. Single-company boards have no employer sign-up: 404 (F39).
 */
import NotFound from '../components/NotFound.astro';
import Base from '../layouts/Base.astro';
import {boardPage} from '../server/board/public-page';

const {site, viewer, board} = await boardPage(Astro.request, Astro.response);
if (!board?.singleCompany) return Astro.redirect(`/account/register/?next=${encodeURIComponent('/dashboard/post-a-job')}`, 302);
Astro.response.status = 404;
---

<Base site={site} viewer={viewer} board={board} title="Page not found" noindex>
  <NotFound site={site} />
</Base>
