---
/**
 * Every `/dashboard/*` URL renders this page; the TanStack Router app inside it
 * picks the screen in the browser. Signed-in users only: the server checks
 * the visitor's own session first, and everyone else gets a sign-in prompt
 * (the Site API checks again on every call — this page is not the guard;
 * the app's shell also sends a signed-out visitor to sign in).
 *
 * The APP layout, not the website's: the portal draws its own full-height
 * shell (sidebar, top bar). The ONLY `.astro` file of the app: never add one
 * per screen.
 */
import App from '../../layouts/App.astro';
import {config} from '../../platform/config';
import {getDb} from '../../platform/db';
import PortalApp from '../../portal/PortalApp';
import type {Me} from '../../portal/shared';
import {brandCssHref} from '../../server/board/brand';
import {pageContext} from '../../server/page';

export const prerender = false;

const [{site, viewer, me}, brandHref] = await Promise.all([pageContext(Astro.request, Astro.response), brandCssHref(getDb())]);
// The visitor this page already read: the app starts from it instead of asking `/site-api/me`
// again before its first screen's reads (one round trip less before the dashboard shows).
const initialMe = viewer.state === 'user' ? (me as Me) : null;
const back = encodeURIComponent(`${Astro.url.pathname}${Astro.url.search}`);
// The editor Preview's gateway drops cookies, so this page never sees the
// session there: the app starts anyway and asks `/site-api/me` itself (its
// shell sends a signed-out visitor to sign in).
const open = viewer.state === 'user' || config.preview;
---

<App site={site} viewer={viewer} title="Dashboard" brandHref={brandHref}>
  {
    open ? (
      <>
        <PortalApp client:only="react" initialMe={initialMe} />
        <noscript>
          <p class="app-gate">The dashboard needs JavaScript.</p>
        </noscript>
      </>
    ) : (
      <main id="main" tabindex="-1" class="app-gate v-gate">
        <div class="v-gate-card">
          <span class="v-gate-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect x="4" y="10.5" width="16" height="10" rx="2.5" />
              <path d="M8 10.5V7.5a4 4 0 0 1 8 0v3" />
              <circle cx="12" cy="15.5" r="1.2" />
            </svg>
          </span>
          <div class="v-gate-head">
            <h1>Sign in to continue</h1>
            <p>Sign in to {site?.name ?? 'this site'} to open your dashboard.</p>
          </div>
          <div class="v-gate-actions">
            <a class="v-gate-go" href={`/account/login/?next=${back}`}>
              Sign in
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </a>
            <a class="v-gate-alt" href={`/account/register/?next=${back}`}>Create an account</a>
          </div>
          <a class="v-gate-back" href="/">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M19 12H5M11 18l-6-6 6-6" />
            </svg>
            Back to the website
          </a>
        </div>
      </main>
    )
  }
</App>
