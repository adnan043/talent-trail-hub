---
/**
 * One job (F3), rendered from `GET /site-api/jobs/:slug`. Open jobs carry `JobPosting` JSON-LD
 * and the apply section (workstream B's `ApplySection`). Expired and closed jobs keep their page
 * (200, `noindex,follow`) with a banner, no apply and no JSON-LD, unless an edit awaits review
 * (`needsReview`: 404 until approved). Unknown, draft, pending, rejected or blocked → 404;
 * a database outage → 503. The view count goes up once per browser session (script below).
 */
import ApplySection from '../../components/apply/ApplySection.astro';
import SaveButton from '../../components/board/SaveButton.astro';
import VelaRowIcon from '../../components/board/VelaRowIcon.astro';
import NotFound from '../../components/NotFound.astro';
import Base from '../../layouts/Base.astro';
import {SALARY_PERIOD_LABELS} from '../../lib/board';
import {initials} from '../../lib/format';
import {jobPostingJsonLd} from '../../lib/json-ld';
import {countryName, employmentLabel, formatPlace, formatSalary, postedAgo, SALARY_NOT_DISCLOSED, shortDate, workplaceAndPlace, workplaceLabel} from '../../lib/job-display';
import {clip, htmlToText} from '../../lib/rich-text';
import {rowIcon} from '../../lib/row-icon';
import type {JobDetailResponse, PublicJobSummary} from '../../lib/types-public';
import {sanitizeHtml} from '../../platform/sanitize';
import {backend, read} from '../../server/backend';
import '../../styles/board-pages.css';
import '../../styles/home-vela.css';
import '../../styles/job-detail-vela.css';
import {boardPage} from '../../server/board/public-page';

const slug = Astro.params.slug ?? '';
const [{site, viewer, board}, answer] = await Promise.all([
  boardPage(Astro.request, Astro.response),
  backend(Astro.request)
    .jobs[':slug'].$get({param: {slug}})
    .catch(() => null),
]);
const data = answer?.ok ? await read<JobDetailResponse>(Promise.resolve(answer)) : null;
const job = data?.job ?? null;
// 404 only when the job really is not there: an outage is a 503, never a "does not exist".
const missing = !job && answer?.status === 404;
if (!job) {
  Astro.response.status = missing ? 404 : 503;
  if (!missing) Astro.response.headers.set('Retry-After', '60');
}
const name = board?.name ?? site?.name ?? 'Talent Trail Hub';
const open = job?.state === 'active';
const salary = job ? formatSalary(job.salary, 'full') : null;
const summary = job ? htmlToText(job.descriptionHtml).replace(/\s+/g, ' ').trim() : '';
const description = job
  ? clip(`${job.title} at ${job.company.name} · ${workplaceAndPlace(job)}. ${summary}`, 160)
  : undefined;
const pageUrl = new URL(`/jobs/${encodeURIComponent(slug)}/`, Astro.url).href;
const shareText = job ? `${job.title} at ${job.company.name}` : '';
const share = [
  {label: 'LinkedIn', href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(pageUrl)}`},
  {label: 'X', href: `https://x.com/intent/post?url=${encodeURIComponent(pageUrl)}&text=${encodeURIComponent(shareText)}`},
  {label: 'Email', href: `mailto:?subject=${encodeURIComponent(shareText)}&body=${encodeURIComponent(pageUrl)}`},
];
const companyHref = job ? `/companies/${encodeURIComponent(job.company.slug)}/` : '/';
const place = job ? formatPlace(job, 'full') : null;
const hiringFrom = job && job.workplaceType === 'remote' && job.applicantCountries.length > 0 ? job.applicantCountries.map(countryName).join(', ') : null;
const metaLine = job
  ? [workplaceAndPlace(job, 'full'), employmentLabel(job.employmentType), job.publishedAt ? `Posted ${postedAgo(job.publishedAt)}` : null].filter(Boolean).join(' · ')
  : '';
/** Where "Apply now" goes: the company's https page, an email, or the on-site form (#apply). */
function directApply(): {href: string; external: boolean; label: string} | null {
  if (!job?.applyTarget) return null;
  if (job.applyMethod === 'url') {
    try {
      return new URL(job.applyTarget).protocol === 'https:' ? {href: job.applyTarget, external: true, label: 'Apply now'} : null;
    } catch {
      return null;
    }
  }
  if (job.applyMethod === 'email' && /^[^\s@"<>]+@[^\s@"<>]+\.[^\s@"<>]{2,}$/.test(job.applyTarget)) {
    return {href: `mailto:${job.applyTarget}?subject=${encodeURIComponent(`Application: ${job.title}`)}`, external: false, label: 'Apply by email'};
  }
  return null;
}
const direct = open ? directApply() : null;
const applyHref = direct?.href ?? '#apply';
const applyLabel = direct?.label ?? 'Apply now';
const applyLinkAttrs = direct ? {'data-apply-click': '', ...(direct.external ? {target: '_blank', rel: 'noopener noreferrer nofollow'} : {})} : {};
const facts = job
  ? [
      {label: 'Job type', value: employmentLabel(job.employmentType)},
      {label: 'Workplace', value: workplaceLabel(job.workplaceType)},
      ...(place ? [{label: 'Location', value: place}] : []),
      ...(hiringFrom ? [{label: 'Hiring from', value: hiringFrom}] : []),
    ]
  : [];

// ---- The "Vela" design (src/styles/job-detail-vela.css; docs: ~/Downloads/Job detail-html).
/** The side card's pay: "$50K – $60K" big, "per year" under it (the period comes off the range). */
const payRange = job?.salary ? (formatSalary(job.salary)?.replace(/\/(hr|day|wk|mo)$/, '') ?? null) : null;
const payPeriod = job?.salary && payRange ? `per ${SALARY_PERIOD_LABELS[job.salary.period]}` : null;
/** "28 days left" next to the apply-by date (whole days, rounded up). */
const daysLeft = open && job?.expiresAt ? Math.max(0, Math.ceil((new Date(job.expiresAt).getTime() - Date.now()) / 86_400_000)) : null;
const leftLabel = daysLeft === null ? null : daysLeft === 0 ? 'Last day' : daysLeft === 1 ? '1 day left' : `${daysLeft} days left`;
/** A company without a logo: its initials on one of the design's tile colours (same name, same colour). */
let nameHash = 0;
for (const ch of job?.company.name ?? '') nameHash = (nameHash * 31 + ch.charCodeAt(0)) >>> 0;
const tile = `vd-tile-${nameHash % 13}`;
const categoryHref = job ? `/jobs/?category=${encodeURIComponent(job.category.slug)}` : '/jobs/';
/** The design's short range in the rows: "$130K – $165K" → "$130K–165K". */
const rowPay = (s: PublicJobSummary) => formatSalary(s.salary)?.replace(/^([^\d\s]*)([\d.,]+[KMBT]?) – \1([\d.,]+[KMBT]?)/, '$1$2–$3') ?? null;
---

{
  job ? (
    <Base
      site={site}
      viewer={viewer}
      board={board}
      title={`${job.title} at ${job.company.name}`}
      description={description}
      image={job.company.logoUrl}
      imageSquare
      imageAlt={job.company.logoUrl ? `${job.company.name} logo` : undefined}
      noindexFollow={!open}
      jsonLd={jobPostingJsonLd(job, {name}) ?? undefined}
      skin="vela">
      <main id="main" tabindex="-1" class="v-home vd" data-job-view={open ? job.slug : undefined}>
        <section class="vd-hero">
          <div class="vd-hero-inner">
            <a class="vd-back" href="/jobs/">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 18l-6-6 6-6"></path></svg>
              All jobs
            </a>
            <div class="vd-head">
              <div class="vd-head-main">
                {job.company.logoUrl ? (
                  <span class="vd-logo vd-logo-72 vd-logo-img" aria-hidden="true">
                    <img src={job.company.logoUrl} alt="" width="72" height="72" loading="eager" decoding="async" />
                  </span>
                ) : (
                  <span class:list={['vd-logo', 'vd-logo-72', tile]} aria-hidden="true">{initials(job.company.name)}</span>
                )}
                <div class="vd-head-text">
                  <p class="vd-company-line">
                    <a class="vd-company" href={companyHref}>{job.company.name}</a>
                    {job.featured && open && (
                      <span class="vd-badge">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z"></path></svg>
                        Featured
                      </span>
                    )}
                    {!open && <span class="vd-badge vd-badge-muted">{job.state === 'closed' ? 'Closed' : 'Expired'}</span>}
                  </p>
                  <h1 class="vd-title">{job.title}</h1>
                </div>
              </div>
              <div class="vd-head-actions">
                <SaveButton slug={job.slug} title={job.title} variant="full" />
                <details class="vd-share" data-share-menu>
                  <summary class="vd-ib vd-ib-icon" aria-label="Share this job">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><path d="m8.6 13.5 6.8 4M15.4 6.5l-6.8 4"></path></svg>
                  </summary>
                  <div class="vd-share-menu">
                    <button type="button" data-web-share={pageUrl} data-share-title={shareText} hidden>Share with an app</button>
                    <button type="button" data-copy-link={pageUrl}>
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 17H7A5 5 0 0 1 7 7h2"></path><path d="M15 7h2a5 5 0 1 1 0 10h-2"></path><line x1="8" x2="16" y1="12" y2="12"></line></svg>
                      Copy link
                    </button>
                    <span class="vd-share-sep" aria-hidden="true"></span>
                    {share.map(s => (
                      <a href={s.href} {...(s.label === 'Email' ? {} : {target: '_blank'})} rel="noopener noreferrer">
                        {s.label}
                        {s.label !== 'Email' && <span class="visually-hidden"> (opens in a new tab)</span>}
                      </a>
                    ))}
                  </div>
                </details>
                <p class="vd-copy-status" data-copy-status role="status" aria-live="polite"></p>
              </div>
            </div>
            <ul class="vd-chips" aria-label="Key facts">
              <li class="vd-chip">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"></path><circle cx="12" cy="9.5" r="2.5"></circle></svg>
                {workplaceAndPlace(job, 'full')}
              </li>
              <li class="vd-chip">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="7" width="20" height="14" rx="2"></rect><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"></path></svg>
                {employmentLabel(job.employmentType)}
              </li>
              <li class="vd-chip vd-chip-cat">
                <VelaRowIcon icon={rowIcon(job.category.name)} />
                {job.category.name}
              </li>
              {job.tags.map(tag => (
                <li class="vd-chip">{tag}</li>
              ))}
              {job.publishedAt && (
                <li class="vd-chip vd-chip-plain">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>
                  Posted {postedAgo(job.publishedAt)}
                </li>
              )}
            </ul>
          </div>
        </section>

        <div class="vd-body">
          {!open && (
            <div class="vd-alert" role="status">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><line x1="12" x2="12" y1="8" y2="12"></line><line x1="12" x2="12.01" y1="16" y2="16"></line></svg>
              <div>
                <p class="vd-alert-title">{job.state === 'closed' ? 'This job has been filled or closed' : 'This job has expired'}</p>
                <p>
                  It no longer accepts applications.{' '}
                  <a class="vd-link" href={categoryHref}>See open {job.category.name} jobs</a>
                </p>
              </div>
            </div>
          )}

          <div class="vd-main">
            <article class="vd-card vd-prose" aria-labelledby="about-job-title">
              <h2 id="about-job-title">About the job</h2>
              <div class="vd-rich" set:html={sanitizeHtml(job.descriptionHtml)} />
            </article>

            {open && !direct && (
              <ApplySection
                job={{
                  id: job.id,
                  slug: job.slug,
                  title: job.title,
                  applyMethod: job.applyMethod,
                  applyTarget: job.applyTarget,
                  companyName: job.company.name,
                  open,
                }}
              />
            )}

            <section class="vd-card vd-co-card" aria-labelledby="company-title">
              <span class="vd-label">About the company</span>
              <div class="vd-company-head">
                <div class="vd-company-id">
                  {job.company.logoUrl ? (
                    <span class="vd-logo vd-logo-56 vd-logo-img" aria-hidden="true">
                      <img src={job.company.logoUrl} alt="" width="56" height="56" loading="lazy" decoding="async" />
                    </span>
                  ) : (
                    <span class:list={['vd-logo', 'vd-logo-56', tile]} aria-hidden="true">{initials(job.company.name)}</span>
                  )}
                  <div class="vd-company-text">
                    <h2 id="company-title">{job.company.name}</h2>
                    {job.company.location && (
                      <span class="vd-company-loc">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"></path><circle cx="12" cy="9.5" r="2.5"></circle></svg>
                        {job.company.location}
                      </span>
                    )}
                  </div>
                </div>
                <div class="vd-company-actions">
                  <a class="vd-sec" href={companyHref}>View company</a>
                  {job.company.website && (
                    <a class="vd-sec" href={job.company.website} target="_blank" rel="noopener noreferrer nofollow">
                      Website
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"></path></svg>
                      <span class="visually-hidden"> (opens in a new tab)</span>
                    </a>
                  )}
                </div>
              </div>
              {job.company.aboutHtml && <div class="vd-about" set:html={sanitizeHtml(job.company.aboutHtml)} />}
              {data!.moreAtCompany.length > 0 && (
                <div class="vd-more">
                  <h3>More jobs at {job.company.name}</h3>
                  <ul class="vd-rows">
                    {data!.moreAtCompany.map(more => (
                      <li>
                        <a class="vd-row" href={`/jobs/${encodeURIComponent(more.slug)}/`}>
                          <span class:list={['vd-row-icon', 'v-row-icon', `cat-${rowIcon(more.title)}`]} aria-hidden="true">
                            <VelaRowIcon icon={rowIcon(more.title)} />
                          </span>
                          <span class="vd-row-body">
                            <span class="vd-row-title">{more.title}</span>
                            <span class="vd-row-meta">{[workplaceAndPlace(more), employmentLabel(more.employmentType)].join(' · ')}</span>
                          </span>
                          {rowPay(more) && <span class="vd-row-pay">{rowPay(more)}</span>}
                          <span class="vd-row-go" aria-hidden="true">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </section>
          </div>

          <aside class="vd-aside" aria-label="Pay and details">
            <div class="vd-pay-card" data-apply-section data-slug={job.slug}>
              <div class="vd-pay-top">
                <div class="vd-pay">
                  <span class="vd-pay-label">Salary</span>
                  {payRange ? (
                    <>
                      <span class="vd-pay-value">{payRange}</span>
                      <span class="vd-pay-period">{payPeriod}</span>
                    </>
                  ) : (
                    <span class="vd-pay-value vd-pay-none">{SALARY_NOT_DISCLOSED}</span>
                  )}
                </div>
                {open && job.expiresAt && (
                  <div class="vd-deadline">
                    <span class="vd-deadline-icon">
                      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M3 10h18M8 3v4M16 3v4"></path></svg>
                    </span>
                    <span class="vd-deadline-text">Apply by <b>{shortDate(job.expiresAt)}</b></span>
                    {leftLabel && <span class="vd-deadline-left">{leftLabel}</span>}
                  </div>
                )}
                {open && (
                  <a class="vd-apply vd-apply-block" href={applyHref} {...applyLinkAttrs}>
                    {applyLabel}
                    {direct?.external && <span class="visually-hidden"> on the company website (opens in a new tab)</span>}
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
                  </a>
                )}
                <span class="vd-free"><span class="vd-free-dot" aria-hidden="true"></span>Candidates never pay to apply</span>
              </div>
              <h2 class="visually-hidden">Key facts</h2>
              <dl class="vd-facts">
                {facts.map(f => (
                  <div>
                    <dt>{f.label}</dt>
                    <dd>{f.value}</dd>
                  </div>
                ))}
                <div>
                  <dt>Category</dt>
                  <dd>
                    <a class="vd-link" href={categoryHref}>{job.category.name}</a>
                  </dd>
                </div>
                <div>
                  <dt>Posted</dt>
                  <dd class="vd-fig">{shortDate(job.publishedAt)}</dd>
                </div>
              </dl>
            </div>
            <div class="vd-safe">
              <span class="vd-safe-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 5 6v5c0 4.5 3 8.3 7 10 4-1.7 7-5.5 7-10V6z"></path></svg>
              </span>
              <p><b>Stay safe.</b> Never pay to apply for a job or share bank details during an application.</p>
            </div>
          </aside>
        </div>

        {data!.similar.length > 0 && (
          <section class="vd-similar" aria-labelledby="similar-title">
            <div class="vd-similar-inner">
              <div class="vd-similar-head">
                <div>
                  <h2 id="similar-title">Similar jobs</h2>
                  <p>More {job.category.name} roles hiring now.</p>
                </div>
                <a class="vd-link vd-similar-all" href={categoryHref}>
                  All {job.category.name} jobs
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
                </a>
              </div>
              <ul class="vd-rows vd-similar-box">
                {data!.similar.map(s => (
                  <li>
                    <a class="vd-row" href={`/jobs/${encodeURIComponent(s.slug)}/`}>
                      <span class:list={['vd-row-icon', 'v-row-icon', `cat-${rowIcon(s.title)}`]} aria-hidden="true">
                        <VelaRowIcon icon={rowIcon(s.title)} />
                      </span>
                      <span class="vd-row-body">
                        <span class="vd-row-title">{s.title}</span>
                        <span class="vd-row-meta">{[s.company.name, workplaceAndPlace(s), employmentLabel(s.employmentType)].join(' · ')}</span>
                      </span>
                      {rowPay(s) && <span class="vd-row-pay">{rowPay(s)}</span>}
                      <span class="vd-row-go" aria-hidden="true">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </section>
        )}

        {open && (
          <div class="jd-bar vd-bar" data-apply-section data-slug={job.slug}>
            <div class="jd-bar-inner">
              <SaveButton slug={job.slug} title={job.title} variant="full" />
              <a class="vd-apply jd-bar-apply" href={applyHref} {...applyLinkAttrs}>
                {applyLabel}
                {direct?.external && <span class="visually-hidden"> on the company website (opens in a new tab)</span>}
              </a>
            </div>
          </div>
        )}
      </main>
    </Base>
  ) : missing ? (
    <Base site={site} viewer={viewer} board={board} title="Page not found" noindex>
      <NotFound site={site} />
    </Base>
  ) : (
    <Base site={site} viewer={viewer} board={board} title="Not available right now" noindex>
      <main id="main" tabindex="-1" class="wrap st-page">
        <div class="st-card">
          <h1>This job is not available right now</h1>
          <p class="st-body">Something went wrong on our side. Try again in a minute.</p>
          <p class="st-actions">
            <a class="button" href="/jobs/">All jobs</a>
          </p>
        </div>
      </main>
    </Base>
  )
}

<script>
  import {siteFetch} from '../../platform/browser';

  document.addEventListener('astro:page-load', () => {
    const main = document.querySelector<HTMLElement>('[data-job-view]');
    if (!main) return;

    // F3: one view per job per browser session.
    const slug = main.dataset.jobView!;
    const key = `board:viewed:${slug}`;
    let first = false;
    try {
      first = !sessionStorage.getItem(key);
      if (first) sessionStorage.setItem(key, '1');
    } catch {
      first = false; // Storage blocked: never count on every load.
    }
    if (first) void siteFetch(`/site-api/jobs/${encodeURIComponent(slug)}/view`, {method: 'POST'}).catch(() => null);

    // F3: an "Apply" click on a url / email job (the side panel and the bottom bar). Those jobs
    // render no apply section, so its script (which counts clicks) never loads: counted here, on
    // the way out, never blocking the link. A link bound already (by the apply section) is skipped.
    document.querySelectorAll<HTMLAnchorElement>('[data-apply-click]').forEach(link => {
      if (link.dataset.clickBound) return;
      link.dataset.clickBound = '1';
      link.addEventListener('click', () => {
        void siteFetch(`/site-api/applications/jobs/${encodeURIComponent(slug)}/click`, {method: 'POST', keepalive: true}).catch(() => null);
      });
    });

    // Web Share where the device has it (phones): the system share sheet.
    const canShare = typeof navigator.share === 'function';
    document.querySelectorAll<HTMLButtonElement>('[data-web-share]').forEach(button => {
      if (!canShare) return;
      button.hidden = false;
      button.addEventListener('click', () => {
        void navigator.share({title: button.dataset.shareTitle, url: button.dataset.webShare}).catch(() => null);
      });
    });

    document.querySelectorAll<HTMLButtonElement>('[data-copy-link]').forEach(copy => {
      const status = copy.closest('[data-share-menu]')?.parentElement?.querySelector<HTMLElement>('[data-copy-status]');
      copy.addEventListener('click', async () => {
        copy.disabled = true;
        copy.setAttribute('aria-busy', 'true');
        try {
          await navigator.clipboard.writeText(copy.dataset.copyLink ?? location.href);
          if (status) status.textContent = 'Link copied.';
        } catch {
          if (status) status.textContent = 'Could not copy. Copy the address from your browser instead.';
        } finally {
          copy.disabled = false;
          copy.removeAttribute('aria-busy');
          copy.closest('details')?.removeAttribute('open');
        }
      });
    });

    // The share menus close on Escape and on a click outside them.
    const menus = [...document.querySelectorAll<HTMLDetailsElement>('[data-share-menu]')];
    const controller = new AbortController();
    document.addEventListener(
      'click',
      event => {
        for (const menu of menus) if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
      },
      {signal: controller.signal}
    );
    document.addEventListener(
      'keydown',
      event => {
        if (event.key !== 'Escape') return;
        for (const menu of menus) {
          if (!menu.open) continue;
          menu.open = false;
          menu.querySelector('summary')?.focus();
        }
      },
      {signal: controller.signal}
    );
    document.addEventListener('astro:before-swap', () => controller.abort(), {once: true});
  });
</script>
